# Copy to a shell environment when you want to override vrt.config.ts.
# This file is not loaded automatically.

# Create missing baselines and treat that as a pass.
# Existing approved baselines are never overwritten by this flag.
VRT_UPDATE_BASELINES=0

# pixelmatch per-pixel color distance. 0 is strict, 1 is loose.
VRT_THRESHOLD=0.1

# Maximum fraction of pixels that may differ (0 to 1).
VRT_MAX_DIFF_RATIO=0.002

# Optional hard cap. When set, a check must satisfy both the ratio and this cap.
# VRT_MAX_DIFF_PIXELS=500

# Ignore pixels pixelmatch classifies as anti-aliased.
VRT_IGNORE_ANTIALIASING=true

# Write a padded diff when sizes differ. The check still fails as a dimension mismatch.
VRT_PAD_DIMENSION_MISMATCH=true

# Append the OS name to baseline files: chromium-desktop-linux.png
VRT_INCLUDE_PLATFORM=false

# Comma-separated browsers. Supported: chromium, firefox, webkit.
VRT_BROWSERS=chromium,firefox,webkit

# Override individual viewports. Format is <width>x<height>.
VRT_VIEWPORT_DESKTOP=1280x800
VRT_VIEWPORT_TABLET=768x1024
VRT_VIEWPORT_MOBILE=390x844
VRT_DEFAULT_VIEWPORT=desktop

# Name stored in the manifest when a baseline is created or approved.
VRT_APPROVER=manual

# Comma-separated selectors that replace the masks from vrt.config.ts when set.
# VRT_MASKS=[data-vrt="timestamp"],[data-vrt="random-id"],[data-vrt="avatar"],[data-vrt="ad"]

# Directory overrides.
# VRT_BASELINE_DIR=baselines
# VRT_ACTUAL_DIR=test-results/visual/actual
# VRT_DIFF_DIR=test-results/visual/diff
# VRT_PENDING_DIR=test-results/visual/pending
# VRT_REPORT_DIR=test-results/visual/report
# VRT_RESULTS_DIR=test-results/visual/results
# VRT_HISTORY_DIR=baselines/history

# Demo server.
PORT=4173

# Used only when a request does not include ?variant=
# Supported: stable, color, font, spacing, size, layout, missing
VRT_DEMO_VARIANT=stable
